{
  "name": "www.relatos.raupulus.dev",
  "version": "1.0.0",
  "description": "Portal oficial para Raupulus Tales — Relatos y Ficción Multimedia",
  "scripts": {
    "build": "python3 scripts/build_site.py",
    "build:css": "npx @tailwindcss/cli -i src/input.css -o public/assets/css/tailwind.css --minify",
